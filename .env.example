# Chave de API do Groq (só para conversar em POST /chat)
# Obtenha gratuitamente em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# mock (padrão da AV2) ou http (gateway SmartCitys local)
DATA_SOURCE=mock

# Gateway local do fork SmartCitysComIA, usado só com DATA_SOURCE=http
BACKEND_BASE_URL=http://127.0.0.1:8080

# Porta da API do chatbot (opcional, padrão: 8000)
PORT=8000
